{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/storage/(.*)",
      "dest": "/public/storage/$1"
    },
    {
  "src": "/css/style.css",
  "dest": "/public/css/style.css"
},{
  "src": "/js/script.js",
  "dest": "/public/js/script.js"
},
    {
      "src": "/(css|js|images|favicon.ico)/(.*)"
    },
    {
      "src": "/stylingtools/(.*)",
      "dest": "/public/stylingtools/$1"
    },
    {
      "src": "/(css|js|images|favicon.ico)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    },
 {
  "src": "/css/app.css",
  "dest": "/css/style.css"
},{
  "src": "/js/app.js",
  "dest": "/js/app.js"
}

  ]
}
